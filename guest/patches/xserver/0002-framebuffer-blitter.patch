+
+#define EMU_FB_STRIDE 4096
+#define EMU_FB_SIZE (EMU_FB_STRIDE * 768)
+
+static volatile CARD32 *emuBlitter;
+static uintptr_t emuFramebuffer;
+static void *emuFramebufferMapping;
+
+enum { EMU_ID, EMU_COMMAND, EMU_SOURCE, EMU_DESTINATION,
+       EMU_WIDTH, EMU_HEIGHT, EMU_AND, EMU_XOR };
+
+static Bool
+emuOffset(FbBits *bits, FbStride stride, int x, CARD32 *offset)
+{
+    uintptr_t address = (uintptr_t) bits;
+    if (stride != EMU_FB_STRIDE / sizeof(FbBits) || x < 0 || (x & 31) ||
+        address < emuFramebuffer || address - emuFramebuffer >= EMU_FB_SIZE ||
+        (unsigned) (x >> 3) >= EMU_FB_SIZE - (address - emuFramebuffer))
+        return FALSE;
+    *offset = address - emuFramebuffer + (x >> 3);
+    return TRUE;
+}
+
+static Bool
+emuRectangle(int width, int height)
+{
+    return width > 0 && width <= EMU_FB_STRIDE * 8 && !(width & 31) &&
+           height > 0 && height <= 768;
+}
+
+static Bool
+emuCopy(FbBits *src, FbStride srcStride, int srcX,
+        FbBits *dst, FbStride dstStride, int dstX,
+        int width, int height, FbBits pm)
+{
+    CARD32 source, destination;
+    if (!emuRectangle(width, height) ||
+        !emuOffset(src, srcStride, srcX, &source) ||
+        !emuOffset(dst, dstStride, dstX, &destination))
+        return FALSE;
+    emuBlitter[EMU_SOURCE] = source;
+    emuBlitter[EMU_DESTINATION] = destination;
+    emuBlitter[EMU_WIDTH] = width >> 3;
+    emuBlitter[EMU_HEIGHT] = height;
+    emuBlitter[EMU_AND] = pm;
+    __sync_synchronize();
+    emuBlitter[EMU_COMMAND] = 1;
+    __sync_synchronize();
+    return emuBlitter[EMU_COMMAND] == 0;
+}
+
+static Bool
+emuSolid(FbBits *dst, FbStride dstStride, int dstX,
+         int width, int height, FbBits and, FbBits xor)
+{
+    CARD32 destination;
+    if (!emuRectangle(width, height) ||
+        !emuOffset(dst, dstStride, dstX, &destination))
+        return FALSE;
+    emuBlitter[EMU_DESTINATION] = destination;
+    emuBlitter[EMU_WIDTH] = width >> 3;
+    emuBlitter[EMU_HEIGHT] = height;
+    emuBlitter[EMU_AND] = and;
+    emuBlitter[EMU_XOR] = xor;
+    __sync_synchronize();
+    emuBlitter[EMU_COMMAND] = 2;
+    __sync_synchronize();
+    return emuBlitter[EMU_COMMAND] == 0;
+}
+
+static void
+emuAccelInit(FbdevPriv *priv)
+{
+    int fd;
+    void *mapping;
+    if (priv->var.bits_per_pixel != 32 || priv->fix.line_length != EMU_FB_STRIDE ||
+        priv->var.xres != 1024 || priv->var.yres != 768 ||
+        access("/proc/device-tree/soc/blitter@10006000/compatible", R_OK) != 0)
+        return;
+    if (!emuBlitter) {
+        fd = open("/dev/mem", O_RDWR | O_SYNC);
+        if (fd < 0)
+            return;
+        mapping = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0x10006000);
+        if (mapping == MAP_FAILED) {
+            close(fd);
+            return;
+        }
+        if (((volatile CARD32 *) mapping)[EMU_ID] != 0x45464201) {
+            munmap(mapping, 4096);
+            close(fd);
+            return;
+        }
+        emuFramebufferMapping = mmap(NULL, EMU_FB_SIZE, PROT_READ | PROT_WRITE,
+                                     MAP_SHARED, fd, 0x87c00000);
+        close(fd);
+        if (emuFramebufferMapping == MAP_FAILED) {
+            emuFramebufferMapping = NULL;
+            munmap(mapping, 4096);
+            return;
+        }
+        emuBlitter = mapping;
+        ErrorF("emulate framebuffer copy/fill acceleration enabled\n");
+    }
+    /* simpledrm's /dev/fb0 mapping is a deferred-I/O shadow, not scanout RAM. */
+    priv->fb = emuFramebufferMapping;
+    emuFramebuffer = (uintptr_t) priv->fb;
+    fbCopyAccelerated = emuCopy;
+    fbSolidAccelerated = emuSolid;
+}
