+static CARD32
+emuResize(OsTimerPtr timer, CARD32 now, void *data)
+{
+    ScreenPtr pScreen = data;
+    KdScreenPriv(pScreen);
+    KdScreenInfo *screen = pScreenPriv->screen;
+    FbdevPriv *priv = screen->card->driver;
+    CARD32 width, height;
+    if (!emuBlitter || !pScreen->root)
+        return 100;
+    width = emuBlitter[8];
+    height = emuBlitter[9];
+    if (width < 320 || width > 2048 || height < 200 || height > 2048 ||
+        (width == pScreen->width && height == pScreen->height))
+        return 100;
+
+    SetRootClip(pScreen, ROOT_CLIP_NONE);
+    screen->width = priv->var.xres = pScreen->width = width;
+    screen->height = priv->var.yres = pScreen->height = height;
+    screen->width_mm = pScreen->mmWidth = (width * 254 + 480) / 960;
+    screen->height_mm = pScreen->mmHeight = (height * 254 + 480) / 960;
+    (*pScreen->ModifyPixmapHeader)(fbGetScreenPixmap(pScreen), width, height,
+        screen->fb.depth, screen->fb.bitsPerPixel, screen->fb.byteStride,
+        screen->fb.frameBuffer);
+    SetRootClip(pScreen, ROOT_CLIP_FULL);
+    RRScreenSizeNotify(pScreen);
+    emuBlitter[10] = (height << 16) | width;
+    __sync_synchronize();
+    return 100;
+}
