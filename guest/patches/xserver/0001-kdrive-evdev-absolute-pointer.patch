Absolute tablet coordinates for kdrive, submitted once per SYN_REPORT.
Both axes belong to one position; submitting each axis separately creates
extra motion events with an intermediate position.

--- a/hw/kdrive/linux/evdev.c
+++ b/hw/kdrive/linux/evdev.c
@@ -91,6 +91,26 @@
     }
 }

+/*
+ * Map one absolute axis from the device's own reported range onto [0, extent).
+ */
+static int
+EvdevScaleAbs(Kevdev * ke, int axis, int extent)
+{
+    int lo = ke->absinfo[axis].minimum;
+    int hi = ke->absinfo[axis].maximum;
+    int v = ke->abs[axis];
+
+    if (hi <= lo || extent < 2)
+        return 0;
+    if (v < lo)
+        v = lo;
+    if (v > hi)
+        v = hi;
+
+    return (int) (((long long) (v - lo) * (extent - 1)) / (hi - lo));
+}
