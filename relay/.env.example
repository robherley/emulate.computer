# Copy to relay/.env for local runs. Vercel only needs REDIS_URL.
# Everything else (quotas, caps, timeouts, port allowlist) is fixed in config.ts.

# Page origins allowed to connect, comma-separated; unset allows all (loopback dev only)
RELAY_ALLOW_ORIGIN=https://emulate.computer
# Redis for the per-IP counters; unset keeps them in memory, per process
REDIS_URL=
